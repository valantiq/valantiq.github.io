// Valantiq knowledge map as a Neo4j property graph (generated by src/knowledge_neo4j.py; do not edit by hand).
// Run with: cypher-shell -f import.cypher   (Neo4j 5). Safe to run twice, it uses MERGE.
CREATE CONSTRAINT point_id IF NOT EXISTS FOR (p:Point) REQUIRE p.id IS UNIQUE;
CREATE CONSTRAINT owner_name IF NOT EXISTS FOR (o:Owner) REQUIRE o.name IS UNIQUE;
UNWIND ["Leadership","Product","Content","Design","Engineering","Data and analytics","Legal and privacy"] AS name MERGE (:Owner {name: name});
UNWIND [
  {id:4,title:"Valantiq never holds the data",owner:"Leadership",kind:"rule",status:"approved",decided:"Sep 2026",summary:"Valantiq never holds or resells an owner's data.",why:"The founder confirmed it is true of every arrangement, and it is one of the four safeguards.",replaces:""},
  {id:7,title:"Nothing goes live without the founder's say",owner:"Leadership",kind:"rule",status:"approved",decided:"",summary:"Releasing the site is a deliberate act. Nothing is committed or pushed to the public repository unless the founder says so in that conversation.",why:"The public repository serves every file in it.",replaces:""},
  {id:8,title:"Settled decisions stay settled",owner:"Leadership",kind:"rule",status:"approved",decided:"",summary:"A decision in the log is reopened only when the founder asks. A new request that reverses an old one says so.",why:"It stops the same questions coming back.",replaces:""},
  {id:18,title:"No case studies",owner:"Product",kind:"rule",status:"approved",decided:"",summary:"No client story is shown. Examples describe a kind of business, never a company.",why:"No client story is approved for publication, and a reader from that kind of business should feel understood, not described.",replaces:""},
  {id:19,title:"Value is never written as money",owner:"Product",kind:"rule",status:"approved",decided:"",summary:"The site names no currency.",why:"Readers are international, so value is expressed in words or as a multiple.",replaces:""},
  {id:21,title:"Direct, plain, not over-formal",owner:"Content",kind:"rule",status:"approved",decided:"",summary:"Short sentences, one clean ask, no hype. It never sounds like a consultancy deck.",why:"Readers are senior and time-poor.",replaces:""},
  {id:22,title:"Delicate things by implication",owner:"Content",kind:"rule",status:"approved",decided:"",summary:"A subtle British corporate register, with understated words and no absolutes.",why:"A hint lands better than a claim. It was applied as \"you bring new revenue\" instead of \"you will look good\".",replaces:""},
  {id:23,title:"Stay neutral about other companies",owner:"Content",kind:"rule",status:"approved",decided:"",summary:"The copy speaks for Valantiq and stays neutral about other companies.",why:"Valantiq works on every route, and says so, never that no route is better for it.",replaces:""},
  {id:24,title:"Name who is speaking",owner:"Content",kind:"rule",status:"approved",decided:"",summary:"\"Valantiq is an independent adviser\" comes before any \"we\" or \"our\".",why:"A reader cannot tell who \"we\" is.",replaces:""},
  {id:25,title:"One idea, one wording",owner:"Content",kind:"rule",status:"approved",decided:"",summary:"When an idea changes in one place, the same idea is searched for everywhere and aligned.",why:"Otherwise the site drifts. \"On top of your core business\" is used everywhere, never \"alongside\".",replaces:""},
  {id:26,title:"Headlines say what you get",owner:"Content",kind:"rule",status:"approved",decided:"",summary:"Section headlines run two rows and carry a claim, never a topic label.",why:"A skimmer should get the whole pitch from the headlines alone.",replaces:""},
  {id:27,title:"The three reads",owner:"Content",kind:"rule",status:"approved",decided:"1 Oct 2026",summary:"Each page is read three ways before it is called done. Headlines alone, headlines with sub-headlines, then whether it convinces from the reader's seat.",why:"It finds the weakest link in the chain a reader follows.",replaces:""},
  {id:28,title:"No colon or semicolon inside a sentence",owner:"Content",kind:"rule",status:"approved",decided:"19 Oct 2026",summary:"Where a sentence needs a break, it ends and a new one starts.",why:"A reader's feedback on 19 October 2026. Labels and addresses keep their colon.",replaces:""},
  {id:29,title:"Break lines between ideas",owner:"Content",kind:"rule",status:"approved",decided:"",summary:"A sentence starts its own row in leads and closings, and wrapped lines are balanced.",why:"Readability and scanning matter more than saving a row.",replaces:""},
  {id:30,title:"British English",owner:"Content",kind:"rule",status:"approved",decided:"",summary:"Licence is the noun and license the verb. Monetisation, anonymise, organisation, adviser.",why:"The site's voice is British.",replaces:""},
  {id:31,title:"Claims are never strengthened",owner:"Content",kind:"rule",status:"approved",decided:"18 Sep 2026",summary:"No claim is added, strengthened or rounded, and no extra caveat is added.",why:"The founder checked every figure on 18 September 2026 and rejected heavier hedging.",replaces:""},
  {id:32,title:"Words for value",owner:"Content",kind:"rule",status:"approved",decided:"",summary:"Value is written in words or as a multiple, never with a currency symbol or a currency name.",why:"It is how the money rule is written into the copy.",replaces:""},
  {id:34,title:"Options first, the founder's pick verbatim",owner:"Content",kind:"rule",status:"approved",decided:"",summary:"Three to five options with one recommendation, then a wait. The chosen wording is applied exactly.",why:"The founder refines in small steps and does not want a full rewrite for a small request.",replaces:""},
  {id:35,title:"All visible words live in one file",owner:"Content",kind:"rule",status:"approved",decided:"",summary:"The approved copy file is the single source for every visible word.",why:"So nothing is typed into the build or the built pages.",replaces:""},
  {id:36,title:"Grounds alternate",owner:"Design",kind:"rule",status:"approved",decided:"19 Oct 2026",summary:"Sections sit on navy, paper or stone, and two neighbours never share one.",why:"A section had landed navy beside navy. The verifier now fails the build if two neighbours match.",replaces:""},
  {id:37,title:"The page is drawn, not boxed",owner:"Design",kind:"rule",status:"approved",decided:"",summary:"Waves and figures divide the page. There are no hairline dividers or boxes.",why:"It is the direction of the V2 design, where anything drawn encodes something the copy says.",replaces:""},
  {id:39,title:"Drawn things say something",owner:"Design",kind:"rule",status:"approved",decided:"",summary:"A drawn figure encodes a real sequence or count and carries no labels of its own.",why:"Decoration says nothing, and every word belongs in the copy file.",replaces:""},
  {id:47,title:"Icons read at a glance",owner:"Design",kind:"rule",status:"approved",decided:"24 Sep 2026",summary:"A shape must be understood at its real size, or it is redrawn.",why:"A padlock without a keyhole, a pointed hexagon and a wedge were each rejected before the shield was drawn.",replaces:""},
  {id:48,title:"A small motion budget",owner:"Design",kind:"rule",status:"approved",decided:"",summary:"One entrance on load. Nothing scrolls by itself and reduced motion is respected.",why:"Stillness after one deliberate entrance is the standing preference.",replaces:""},
  {id:58,title:"Only the built site is public",owner:"Engineering",kind:"rule",status:"approved",decided:"",summary:"The source stays private. Only the built site is published, and the build fails if anything unpublishable lands in it.",why:"The public repository serves every file in it.",replaces:""},
  {id:60,title:"Screenshots on every reader device",owner:"Engineering",kind:"rule",status:"approved",decided:"",summary:"After any change, a screenshot at every reader device is looked at before the work is called done.",why:"The readers' devices are fixed, and an overflow on one of them is a bug.",replaces:""},
  {id:67,title:"Retention matches the privacy page",owner:"Data and analytics",kind:"rule",status:"approved",decided:"19 Oct 2026",summary:"Google Analytics keeps visit data for two months. The behaviour tool keeps recordings for up to 13 months.",why:"The privacy page states both, so the settings were checked and changed to match.",replaces:""},
  {id:69,title:"No real names",owner:"Legal and privacy",kind:"rule",status:"approved",decided:"",summary:"No client, prospect, partner, fund or employer is named, with a few approved exceptions about the founder's own record.",why:"The pipeline and the partners are confidential.",replaces:""},
  {id:70,title:"Analytics only after consent",owner:"Legal and privacy",kind:"rule",status:"approved",decided:"",summary:"Nothing from Google or Microsoft loads until a visitor presses Accept.",why:"A hard rule. The verifier fails the build if a page names Google's tag or analytics addresses.",replaces:""},
  {id:73,title:"No other third parties",owner:"Legal and privacy",kind:"rule",status:"approved",decided:"",summary:"No embeds, no font network and no other trackers.",why:"Anything else would send data to a third party before a visitor has chosen.",replaces:""}
] AS row
MERGE (p:Point {id: row.id})
SET p:Rule, p.title = row.title, p.owner = row.owner, p.kind = row.kind, p.status = row.status, p.decided = row.decided, p.summary = row.summary, p.why = row.why, p.replaces = row.replaces;
UNWIND [
  {id:12,title:"The home page follows the owner's questions",owner:"Product",kind:"decision",status:"approved",decided:"1 Oct 2026",summary:"Funds already pay for data like yours, which of your data a fund wants, what it adds to the P&L, the seven questions, the routes, where Valantiq fits, the safeguards and one ask.",why:"It is the order in which a data owner's doubts arrive, so each answer comes before the next question.",replaces:""},
  {id:17,title:"One closing ask",owner:"Product",kind:"decision",status:"approved",decided:"24 Oct 2026",summary:"The home page ends on \"Tell us what you hold\", and the header carries a \"Get in touch\" button on every page.",why:"One clean ask. The header button read \"Tell us what you need\" until it became \"Get in touch\", option 1 of five.",replaces:"The header button \"Tell us what you need\""},
  {id:38,title:"One type scale, three sizes",owner:"Design",kind:"decision",status:"approved",decided:"15 Oct 2026",summary:"Three font sizes across the page. A phone may have its own three.",why:"A reader's feedback that there should be no more than three. Nine type roles had built up.",replaces:"Nine type roles"},
  {id:45,title:"Header: top-level pages only",owner:"Design",kind:"decision",status:"approved",decided:"23 Sep 2026",summary:"Data owners, Data buyers, About and one \"Get in touch\" button.",why:"A page existing is not a reason for a place in the header.",replaces:""},
  {id:46,title:"The footer is quiet and compact",owner:"Design",kind:"decision",status:"approved",decided:"24 Sep 2026",summary:"Links with small icons, the registered office, the disclaimer and the copyright, kept quieter than the page above.",why:"It went through ten rounds of small cuts because it read heavier than the content above it.",replaces:""},
  {id:49,title:"One row style for what opens, on phones",owner:"Design",kind:"decision",status:"approved",decided:"12 Oct 2026",summary:"Everything that expands on a phone uses one row and one sign for \"this opens\".",why:"Reviewers' notes on the mobile site showed several styles for one job.",replaces:""},
  {id:50,title:"The first redesign was replaced",owner:"Design",kind:"decision",status:"approved",decided:"Oct 2026",summary:"The first redesign, with oyster paper and a serif, was replaced by the current look.",why:"It is kept on a tag so nothing is lost.",replaces:"The first redesign"},
  {id:51,title:"The rotating cube was removed",owner:"Design",kind:"decision",status:"approved",decided:"18 Sep 2026",summary:"The launch page's rotating cube is gone.",why:"It read as \"coming soon\" while the copy argues this is an established market, and it encoded nothing about the business.",replaces:"The launch page's cube"},
  {id:56,title:"Static and fast",owner:"Engineering",kind:"decision",status:"approved",decided:"",summary:"Plain static pages on GitHub Pages. Only the consent script handles visitors' choices, and every page works without the presentation script.",why:"Fast, cheap to host and easy to hand over.",replaces:""},
  {id:57,title:"Fonts are self-hosted",owner:"Engineering",kind:"decision",status:"approved",decided:"",summary:"Inter and Source Serif 4 italic are served from the site itself.",why:"No Google Fonts request, so it is faster and nothing goes to a third party before consent.",replaces:""},
  {id:61,title:"The phone menu is a native popover",owner:"Engineering",kind:"decision",status:"approved",decided:"23 Sep 2026",summary:"The phone menu uses the browser's own popover, so it needs no script.",why:"A script-free menu kept rendering behind the hero. The popover renders in the browser's top layer, above everything.",replaces:""},
  {id:65,title:"Email click is the one conversion",owner:"Data and analytics",kind:"decision",status:"approved",decided:"19 Oct 2026",summary:"Only a click on an email button counts as a key event. Everything else is an ordinary event.",why:"It is the only conversion on a site with no forms. A click shows intent, not that an email was sent.",replaces:""},
  {id:71,title:"Accept and Decline carry equal weight",owner:"Legal and privacy",kind:"decision",status:"approved",decided:"11 Oct 2026",summary:"The cookie prompt gives both choices the same weight, and a visitor can change their mind at any time.",why:"It is by design.",replaces:""}
] AS row
MERGE (p:Point {id: row.id})
SET p:Decision, p.title = row.title, p.owner = row.owner, p.kind = row.kind, p.status = row.status, p.decided = row.decided, p.summary = row.summary, p.why = row.why, p.replaces = row.replaces;
UNWIND [
  {id:1,title:"Valantiq",owner:"Leadership",kind:"fact",status:"approved",decided:"2025",summary:"An independent adviser that helps data-rich businesses license their marketing data to hedge funds and asset managers.",why:"The point to land is that this is marketing data, and that the same data can earn new revenue from investment managers.",replaces:""},
  {id:2,title:"Three routes to market",owner:"Leadership",kind:"fact",status:"approved",decided:"Oct 2026",summary:"In-house, Hybrid or Outsource. A new team, an existing team with outside help, or a partner who builds it.",why:"No route suits everyone. What a client's own agreements allow decides which route fits, and whether to license at all.",replaces:""},
  {id:3,title:"How Valantiq is paid",owner:"Leadership",kind:"fact",status:"approved",decided:"4 Oct 2026",summary:"The commission comes from the seller's side. A fund does not pay for scouting.",why:"It is stated outright on the data buyers page, so a reader knows whose side the commission sits on.",replaces:""},
  {id:5,title:"The approved claims",owner:"Leadership",kind:"fact",status:"approved",decided:"18 Sep 2026",summary:"One list of the figures and claims the site makes, such as 17 years, 20+ awards and 300+ funds and asset managers within reach.",why:"The founder checked each one. None is added, strengthened or rounded, and each carries its condition where it has one.",replaces:""},
  {id:6,title:"Time to first revenue",owner:"Leadership",kind:"fact",status:"approved",decided:"11 Oct 2026",summary:"Each route is given a best case and a realistic case, from the founder's own experience. The shortest carries its condition in the words \"if nothing slows it down\".",why:"It comes from the founder's own experience, and no figure is stated without its condition.",replaces:""},
  {id:9,title:"Two readers",owner:"Product",kind:"fact",status:"approved",decided:"",summary:"The data owner, who leads a marketing, media, research or tech business rich in marketing data. And the fund or asset manager that sources data.",why:"Most visitors arrive after an email or an introduction and give the site about a minute, so each page is written for one of the two.",replaces:""},
  {id:10,title:"The data owner's biggest fear",owner:"Product",kind:"fact",status:"approved",decided:"1 Oct 2026",summary:"That selling data, even anonymised and aggregated, would harm relationships with existing clients.",why:"So the page says clients come first, and that what their agreements allow decides the route and whether to license at all.",replaces:""},
  {id:11,title:"What each page is for",owner:"Product",kind:"fact",status:"approved",decided:"23 Sep 2026",summary:"Data owners, which is the home page, carries the whole argument. Data buyers speaks to funds. About says who is behind Valantiq. Privacy is legal and plain.",why:"The site was split by audience on 23 September 2026, and each page has since been read from its own reader's seat.",replaces:""},
  {id:13,title:"Marketing data, a second market",owner:"Product",kind:"fact",status:"approved",decided:"",summary:"The same marketing data can earn new revenue from funds, on top of the core business.",why:"An early headline, \"Same data. A second market.\", was dropped because it never said marketing.",replaces:""},
  {id:14,title:"Ten data types, with fixed names",owner:"Product",kind:"fact",status:"approved",decided:"2 Oct 2026",summary:"Ten kinds of marketing data, each with its own row, from advertising spend to search data.",why:"The names are canonical. Change one and it changes everywhere it is named. News and event data was added on 2 October 2026.",replaces:""},
  {id:15,title:"Seven questions a fund asks",owner:"Product",kind:"fact",status:"approved",decided:"19 Oct 2026",summary:"The seven questions that decide whether a fund will give a dataset a try, from whether it maps to listed companies to whether it will pass compliance.",why:"Funds judge data differently from marketers, and knowing the questions in advance can multiply what the data earns.",replaces:""},
  {id:16,title:"The case: five properties",owner:"Product",kind:"fact",status:"approved",decided:"",summary:"Licence income is recurring, sticky, incremental, high margin and near-term.",why:"Five properties in a fixed order, each making one point. Sticky was split out of recurring for that reason.",replaces:""},
  {id:20,title:"Reader devices",owner:"Product",kind:"fact",status:"approved",decided:"",summary:"The last three iPhone generations, and a company MacBook Air or a corporate ThinkPad.",why:"Both readers use the same kit, so every change is checked on all of it.",replaces:""},
  {id:33,title:"The hero line",owner:"Content",kind:"fact",status:"approved",decided:"",summary:"\"Your marketing data can earn new revenue from hedge funds.\"",why:"The point to land is that this is marketing data that can earn new revenue from funds.",replaces:""},
  {id:40,title:"The wave",owner:"Design",kind:"fact",status:"approved",decided:"",summary:"A drawn wave is the site's motif. In the hero, three waves flow into one point and leave as one line.",why:"Many signals becoming one source of value is the idea the copy describes.",replaces:""},
  {id:41,title:"Constellation on the wave",owner:"Design",kind:"fact",status:"approved",decided:"4 Oct 2026",summary:"Scattered points settle into a wave and name the choices as a reader scrolls.",why:"A choose-one that plays as you scroll. The recipe is recorded so the next one follows it.",replaces:""},
  {id:42,title:"Data types as a picker",owner:"Design",kind:"fact",status:"approved",decided:"2 Oct 2026",summary:"A long table of data types became one choice and one answer.",why:"A big table was hard to take in. The same method is meant for other tables.",replaces:""},
  {id:43,title:"The routes table",owner:"Design",kind:"fact",status:"approved",decided:"",summary:"Three routes compared on time, cost, risk and what you get, in rows that open one at a time.",why:"Rows give a reader the comparison first and the detail on request.",replaces:""},
  {id:44,title:"The hero",owner:"Design",kind:"fact",status:"approved",decided:"4 Oct 2026",summary:"A headline, a sub-line, a button and a text link, beside a drawn figure and a strip of three proof points.",why:"It was composed so the headline holds two rows and the sub-line at most three on a laptop.",replaces:""},
  {id:52,title:"A small script builds the site",owner:"Engineering",kind:"fact",status:"approved",decided:"",summary:"A Python script turns the copy and the stylesheet into plain static pages.",why:"It keeps the build short enough to read and easy to hand over.",replaces:""},
  {id:53,title:"The build reads the one copy file",owner:"Engineering",kind:"fact",status:"approved",decided:"",summary:"Every visible word comes from the copy file.",why:"It is how the single-source rule is kept.",replaces:""},
  {id:54,title:"The verifier checks every build",owner:"Engineering",kind:"fact",status:"approved",decided:"",summary:"A second script checks that every sentence reached the pages, that links, counts, grounds and consent loading are right, and that nothing unpublishable is published.",why:"Slips in names, arithmetic and counts cost trust, so the build must end with all checks passed.",replaces:""},
  {id:55,title:"The verifier fails on currency wording",owner:"Engineering",kind:"fact",status:"approved",decided:"",summary:"Any currency symbol or currency name fails the build.",why:"It is the check behind the money rule.",replaces:""},
  {id:59,title:"Release is staged by hand",owner:"Engineering",kind:"fact",status:"approved",decided:"",summary:"A script stages the built site in the public repository's clone. It never commits or pushes.",why:"It carries out the founder's rule that nothing goes live without his say.",replaces:""},
  {id:62,title:"Design-system handover package",owner:"Engineering",kind:"fact",status:"approved",decided:"20 Oct 2026",summary:"Tokens, guides, screenshots, fonts and reference code, regenerated from the live site.",why:"The earlier package had drifted. Nine type roles had become three.",replaces:""},
  {id:63,title:"Version history",owner:"Engineering",kind:"fact",status:"approved",decided:"19 Oct 2026",summary:"The launch page, then the V2 redesign released on 19 October 2026, followed by 2.1 and 2.2 the same day.",why:"Each release is tagged so any version can be recovered.",replaces:""},
  {id:64,title:"What is measured",owner:"Data and analytics",kind:"fact",status:"approved",decided:"19 Oct 2026",summary:"Which pages and sections are viewed, how far people scroll, and what they open and click.",why:"A site with no forms has no other signal. Only the visitor's own actions count, not the page's own animation.",replaces:""},
  {id:66,title:"Tag Manager carries the tags",owner:"Data and analytics",kind:"fact",status:"approved",decided:"11 Oct 2026",summary:"Google Analytics and a behaviour tool run inside one container that loads only after Accept.",why:"Google's own snippet would load before consent, so the consent script loads the container instead.",replaces:""},
  {id:68,title:"The monthly review",owner:"Data and analytics",kind:"fact",status:"approved",decided:"",summary:"Reports are read once a month. Where readers stop, what they open and which button gets the click.",why:"Traffic is low, so patterns are read over a month, not days.",replaces:""},
  {id:72,title:"The privacy page says exactly this",owner:"Legal and privacy",kind:"fact",status:"approved",decided:"19 Oct 2026",summary:"It names what loads, when, and who receives it, including Google Analytics, Tag Manager and Clarity.",why:"If the behaviour changes, the wording changes first.",replaces:""}
] AS row
MERGE (p:Point {id: row.id})
SET p:Fact, p.title = row.title, p.owner = row.owner, p.kind = row.kind, p.status = row.status, p.decided = row.decided, p.summary = row.summary, p.why = row.why, p.replaces = row.replaces;
MATCH (p:Point) MATCH (o:Owner {name: p.owner}) MERGE (p)-[:OWNED_BY]->(o);
UNWIND [{a:12,b:9},{a:11,b:9},{a:21,b:9},{a:26,b:9},{a:19,b:9},{a:16,b:9},{a:49,b:20},{a:60,b:20},{a:2,b:10},{a:52,b:56},{a:61,b:56},{a:57,b:73},{a:66,b:70},{a:18,b:69},{a:13,b:1},{a:4,b:10},{a:15,b:9},{a:29,b:21},{a:51,b:48},{a:71,b:70}] AS e
MATCH (x:Point {id: e.a}), (y:Point {id: e.b})
MERGE (x)-[:BECAUSE_OF]->(y);
UNWIND [{a:19,b:32},{a:5,b:31},{a:13,b:33},{a:70,b:72},{a:64,b:72},{a:66,b:72},{a:67,b:72},{a:71,b:72}] AS e
MATCH (x:Point {id: e.a}), (y:Point {id: e.b})
MERGE (x)-[:WRITTEN_AS]->(y);
UNWIND [{a:7,b:59},{a:19,b:55},{a:32,b:55},{a:5,b:54},{a:31,b:54},{a:36,b:54},{a:70,b:54},{a:58,b:54},{a:35,b:53},{a:35,b:54},{a:20,b:60}] AS e
MATCH (x:Point {id: e.a}), (y:Point {id: e.b})
MERGE (x)-[:ENFORCED_BY]->(y);
UNWIND [{a:42,b:14},{a:64,b:42},{a:43,b:2},{a:41,b:40},{a:44,b:40},{a:44,b:33},{a:64,b:70},{a:64,b:66},{a:65,b:64},{a:68,b:64},{a:17,b:45},{a:54,b:53},{a:59,b:54},{a:62,b:38},{a:6,b:5},{a:46,b:47},{a:24,b:1},{a:2,b:1},{a:5,b:1},{a:23,b:2},{a:3,b:11},{a:8,b:7},{a:12,b:14},{a:12,b:15},{a:12,b:16},{a:12,b:2},{a:22,b:21},{a:25,b:35},{a:27,b:26},{a:28,b:21},{a:40,b:39},{a:44,b:48},{a:63,b:59},{a:67,b:66},{a:34,b:8}] AS e
MATCH (x:Point {id: e.a}), (y:Point {id: e.b})
MERGE (x)-[:DEPENDS_ON]->(y);
UNWIND [{a:50,b:36},{a:50,b:37},{a:50,b:38}] AS e
MATCH (x:Point {id: e.a}), (y:Point {id: e.b})
MERGE (x)-[:REPLACED_BY]->(y);
